# Firebase deploy settings (NON-SECRET values only). Rename this file to  .env.<your-project-id>
# e.g. if your project id is muranga-portal-prod  ->  backend/.env.muranga-portal-prod
# firebase deploy loads it automatically. Do not use keys starting with FIREBASE_ or X_GOOGLE_ (reserved).
#
# SECRETS do NOT go here. Set them with:
#   firebase functions:secrets:set JWT_SECRET
#   firebase functions:secrets:set ADMIN_PASSWORD
#   (live SMS/M-Pesa only) AT_API_KEY, MPESA_KEY, MPESA_SECRET, MPESA_PASSKEY  -> then add them to LIVE_SECRETS in backend/index.js

# Region of the Cloud Function. Must match the "region" in the hosting rewrite in firebase.json.
FUNCTION_REGION=africa-south1

# Cloud Storage bucket for uploaded documents. Empty = the project's default bucket.
# Find it in Console > Storage, e.g. your-project-id.firebasestorage.app
STORAGE_BUCKET=

# Footer contact details (shown only when set)
SUPPORT_PHONE="+254 757 562 988"
SUPPORT_EMAIL=" info@muranga.go.ke"

# Uploads and abuse protection
MAX_UPLOAD_MB=8
RATE_LIMIT=10

# SMS: Africa's Talking (non-secret parts). Use AT_USERNAME=sandbox to test.
AT_USERNAME=
AT_SENDER_ID=
SMS_NOTIFY_OFFICERS=

# M-Pesa (non-secret parts)
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://YOUR-DOMAIN/api/mpesa/callback
MPESA_BASE=https://sandbox.safaricom.co.ke
